{
  "extends": "../../tooling/typescript/nestjs.json",
  "compilerOptions": {
    "rootDir": "../../",
    "outDir": "./dist",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "types": [
      "node"
    ],

    "paths": {
      "@nexuva/types": [
        "../../packages/types/src/index.ts"
      ],
      "@nexuva/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test"
  ]
}
