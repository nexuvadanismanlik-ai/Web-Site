# ============================================================
# NEXUVA OS — Environment Variables
# Copy this file to .env and fill in all values before running
# ============================================================

# --- Database (Supabase PostgreSQL) ---
# Supabase → Project Settings → Database → Connection string.
# Use the pooled connection (port 6543, pgbouncer) for the running app and the
# direct connection (port 5432) for Prisma migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- API (NestJS) ---
API_PORT=4000
API_PREFIX=/api/v1
NODE_ENV=development

# --- JWT ---
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Website CMS ---
# Tenant slug whose website content is served when a request does not name one.
WEBSITE_TENANT_SLUG=nexuva

# --- Public Website (Next.js, static export) ---
# Baked into the build — the static site calls this at runtime for the
# contact form, and at build time for site content.
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Admin Panel (Next.js) ---
ADMIN_PORT=3001
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1

# --- Cloudflare R2 Storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nexuva-os
R2_PUBLIC_URL=

# --- Email Provider ---
# Supported: resend | sendgrid | smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@nexuva.com
EMAIL_FROM_NAME=Nexuva OS

# Resend
RESEND_API_KEY=

# SendGrid
SENDGRID_API_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Feature Flags ---
# Global default overrides (optional — managed via admin panel in production)
FF_PAGE_VERSIONING=true
FF_AI_SEO=false

# --- Logging ---
LOG_LEVEL=debug
