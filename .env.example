# ============================================================
# NEXUVA OS — Environment Variables
# Copy this file to .env and fill in all values before running
# ============================================================

# --- Database (Supabase PostgreSQL) ---
# Supabase → Project Settings → Database → Connection string.
# Use the pooled connection (port 6543, pgbouncer) for the running app and the
# direct connection (port 5432) for Prisma migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- API (NestJS) ---
API_PORT=4000
API_PREFIX=/api/v1
NODE_ENV=development

# --- JWT ---
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Website CMS ---
# Tenant slug whose website content is served when a request does not name one.
WEBSITE_TENANT_SLUG=nexuva

# --- Publishing: how edited content reaches the public site ---
# 'deploy-hook' — rebuild the site. Required while it is a static export.
# 'revalidate'  — invalidate the site's cache. Target once it runs as a Web
#                 Service with ISR; see apps/web/MIGRATION.md.
# 'none'        — publishing disabled (the admin shows it as unconfigured).
PUBLISH_STRATEGY=none

# Strategy: deploy-hook — Render → website service → Settings → Deploy Hook
RENDER_DEPLOY_HOOK_URL=

# Strategy: revalidate — must match REVALIDATE_SECRET on the website service
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=

# Publish automatically after a content change instead of waiting for the
# editor to press Publish. Leave false while publishing means a rebuild.
PUBLISH_AUTO=false
PUBLISH_DEBOUNCE_MS=60000

# --- Seed account (apps/api/prisma/seed.cjs) ---
# Creates/updates the initial SUPER_ADMIN the admin panel signs in with.
# Change the password before seeding anything public.
ADMIN_EMAIL=admin@nexuva.com
ADMIN_PASSWORD=nexuva123
ADMIN_FIRST_NAME=Nexuva
ADMIN_LAST_NAME=Admin

# --- Public Website (Next.js, static export) ---
# Baked into the build — the static site calls this at runtime for the
# contact form, and at build time for site content.
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Admin Panel (Next.js) ---
# The panel authenticates against the API and keeps no user store of its own.
# NOTE: Next.js reads .env from each app directory, not the repo root — see
# apps/admin/.env.local and apps/web/.env.local for local development.
ADMIN_PORT=3001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change_this_admin_session_secret
# Target of the visual editor's preview iframe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare R2 Storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nexuva-os
R2_PUBLIC_URL=

# --- Email Provider ---
# Supported: resend | sendgrid | smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@nexuva.com
EMAIL_FROM_NAME=Nexuva OS

# Resend
RESEND_API_KEY=

# SendGrid
SENDGRID_API_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Feature Flags ---
# Global default overrides (optional — managed via admin panel in production)
FF_PAGE_VERSIONING=true
FF_AI_SEO=false

# --- Logging ---
LOG_LEVEL=debug
