{
  "name": "@nexuva/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "lint": "eslint \"{app,components,lib}/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test \".test-dist/apps/web/test/*.test.js\"",
    "test:build": "node --test test/build-output.check.mjs"
  },
  "dependencies": {
    "@nexuva/shared": "workspace:*",
    "@nexuva/types": "workspace:*",
    "@nexuva/ui": "workspace:*",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.427.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}
