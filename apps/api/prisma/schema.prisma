// Nexuva OS — Prisma Schema
// Tenant-First Architecture
// PostgreSQL + JSONB
//
// PARTIAL UNIQUE INDEXES (managed via migration):
//   feature_flags:   global key uniqueness enforced in migration SQL (C-2)
//   system_settings: global key uniqueness enforced in migration SQL (C-2)
//   pages:           active-slug uniqueness enforced via partial index (H-6)
//                    @@unique([tenantId, slug, locale]) removed — see migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime traffic goes through Supabase's transaction pooler (pgbouncer).
  url      = env("DATABASE_URL")
  // Migrations need a session-mode connection; pgbouncer cannot run DDL.
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TenantType {
  HOLDING
  PRODUCT
}

enum CompanyType {
  HOLDING
  SUBSIDIARY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  BETA
  ARCHIVED
}

enum DomainType {
  PRIMARY
  SUBDOMAIN
  REDIRECT
  ALIAS
}

enum BlockType {
  HERO
  TEXT
  IMAGE
  GALLERY
  CTA
  FEATURES
  TESTIMONIALS
  FAQ
  CUSTOM
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PRODUCT_MANAGER
  CONTENT_EDITOR
  VIEWER
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  TEXT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

// ============================================================
// TENANT — Primary deployable unit
// Every domain resolves to a Tenant. Company and Product are
// organizational overlays on top of Tenant.
// ============================================================

model Tenant {
  id          String     @id @default(cuid())
  slug        String     @unique
  type        TenantType
  name        String
  description String?
  isActive    Boolean    @default(true)

  // Relations
  company       Company?
  product       Product?
  domains       Domain[]
  pages         Page[]
  branding      Branding?
  settings      SystemSetting[]
  featureFlags  FeatureFlag[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  storageFiles  StorageFile[]

  // Website CMS
  websiteSections     WebsiteSection[]
  websiteNavItems     WebsiteNavItem[]
  websiteLogos        WebsiteLogo[]
  websiteServices     WebsiteService[]
  websiteStats        WebsiteStat[]
  websiteReferences   WebsiteReference[]
  websiteTestimonials WebsiteTestimonial[]
  websiteProcessSteps WebsiteProcessStep[]
  contactMessages     ContactMessage[]
  publishLogs         PublishLog[]
  websiteState        WebsiteState?
  contentVersions     ContentVersion[]

  // Mail
  mailSettings  MailSettings?
  mailTemplates MailTemplate[]
  mailLogs      MailLog[]

  // Analytics
  pageViews       PageView[]
  analyticsEvents AnalyticsEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([type])
  @@map("tenants")
}

// ============================================================
// COMPANY — Legal entity, linked 1:1 to a Tenant
// ============================================================

model Company {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  type        CompanyType
  legalName   String?
  taxId       String?
  description String?

  parentId     String?
  parent       Company?  @relation("CompanyHierarchy", fields: [parentId], references: [id])
  subsidiaries Company[] @relation("CompanyHierarchy")

  products Product[]
  users    User[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([type])
  @@map("companies")
}

// ============================================================
// PRODUCT — Software product, linked 1:1 to a Tenant
// ============================================================

model Product {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([status])
  @@map("products")
}

// ============================================================
// DOMAIN — Maps a domain name to a Tenant
// ============================================================

model Domain {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  domainName String     @unique
  type       DomainType @default(PRIMARY)
  isActive   Boolean    @default(true)
  redirectTo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("domains")
}

// ============================================================
// PAGE — CMS page, scoped to a Tenant
//
// Slug uniqueness is enforced via a PARTIAL UNIQUE INDEX in the
// managed migration (H-6): only active (deletedAt IS NULL) pages
// are subject to the constraint. Soft-deleted pages release their
// slug so a new page can reuse it.
// @@unique([tenantId, slug, locale]) intentionally absent here.
// ============================================================

model Page {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  slug           String
  title          String
  isPublished    Boolean @default(false)
  locale         String  @default("tr")
  currentVersion Int     @default(1)

  contentBlocks ContentBlock[]
  seoSetting    SeoSetting?
  versions      PageVersion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@index([tenantId, locale])
  @@map("pages")
}

// ============================================================
// CONTENT BLOCK — Ordered block within a Page
// ============================================================

model ContentBlock {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  type      BlockType
  content   Json
  position  Int
  isVisible Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([pageId])
  @@index([pageId, position])
  @@index([pageId, deletedAt])
  @@map("content_blocks")
}

// ============================================================
// PAGE VERSION — Full content snapshot for rollback
// ============================================================

model PageVersion {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  versionNumber   Int
  title           String
  contentSnapshot Json
  seoSnapshot     Json?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([pageId, versionNumber])
  @@index([pageId])
  // Composite descending index for captureVersionInTx hot path (H-4)
  @@index([pageId, versionNumber(sort: Desc)])
  @@index([createdById])
  @@map("page_versions")
}

// ============================================================
// SEO SETTING — 1:1 with Page
// ============================================================

model SeoSetting {
  id     String @id @default(cuid())
  pageId String @unique
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  metaTitle       String?
  metaDescription String?
  keywords        String[]
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  twitterCard     String?
  canonicalUrl    String?
  noIndex         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seo_settings")
}

// ============================================================
// BRANDING — 1:1 with Tenant
// ============================================================

model Branding {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  fontHeading    String?
  fontBody       String?
  themePreset    String?
  customCss      String?
  config         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branding")
}

// ============================================================
// USER — Platform user, optional company scope
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  lastLoginAt DateTime?

  pageVersions  PageVersion[]
  auditLogs     AuditLog[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  storageFiles  StorageFile[]
  publishLogs   PublishLog[]
  contentVersions ContentVersion[]
  assignedLeads ContactMessage[] @relation("LeadAssignee")
  leadNotes     LeadNote[]
  leadActivities LeadActivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([role])
  @@map("users")
}

// ============================================================
// REFRESH TOKEN — Hashed refresh tokens for secure rotation
// ============================================================

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

// ============================================================
// PERMISSION — Role-based permission matrix
// ============================================================

model Permission {
  id       String   @id @default(cuid())
  role     UserRole
  resource String
  actions  Json

  @@unique([role, resource])
  @@map("permissions")
}

// ============================================================
// FEATURE FLAG — Per-tenant or global feature switches
// Global uniqueness (tenantId IS NULL) enforced via partial index
// in managed migration (C-2). @@unique([key, tenantId]) covers
// tenant-scoped records only (NULL != NULL in PostgreSQL).
// ============================================================

model FeatureFlag {
  id          String  @id @default(cuid())
  key         String
  name        String
  description String?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  isEnabled Boolean @default(false)
  config    Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([key, tenantId])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([isEnabled])
  @@map("feature_flags")
}

// ============================================================
// SYSTEM SETTING — Key/value store, global or per-tenant
// Same NULL uniqueness caveat as FeatureFlag — see schema header.
// ============================================================

model SystemSetting {
  id          String      @id @default(cuid())
  key         String
  value       Json
  type        SettingType @default(STRING)
  description String?
  isPublic    Boolean     @default(false)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([key, tenantId])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, isPublic])
  @@map("system_settings")
}

// ============================================================
// STORAGE FILE — Tracked file uploads to Cloudflare R2
// Every upload creates a DB record for quota tracking, ownership
// enforcement, and audit logging. Soft-deleted records retain
// their metadata after the R2 object is removed.
// ============================================================

model StorageFile {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  key      String  // R2 object key (e.g. "tenant-slug/images/1700000000000-photo.jpg")
  url      String  // Public CDN URL
  mimeType String
  size     Int     // bytes — used for per-tenant quota calculation
  folder   String  @default("uploads")
  filename String  // original filename from the upload

  /// Set when the file was attached to an enquiry rather than uploaded to the
  /// library on its own.
  leadId String?
  lead   ContactMessage? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Present when the bytes live in this database rather than in object
  /// storage. See StorageBlob.
  blob StorageBlob?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([uploadedById])
  @@index([leadId])
  @@map("storage_files")
}

/// File contents, when there is nowhere else to put them.
///
/// Object storage is the right home for uploads and stays the default whenever
/// it is configured. But it needs credentials somebody has to go and create,
/// and until they exist the panel cannot accept a logo, a favicon or a share
/// image — which blocks most of what the CMS is for. A corporate site's brand
/// assets are a handful of files measured in kilobytes, and Postgres holds
/// those perfectly well.
///
/// Separate from StorageFile so listing the library never drags the bytes: the
/// media screen reads names and sizes, and a query that also returned every
/// image would be unusable by the tenth upload.
model StorageBlob {
  id     String      @id @default(cuid())
  fileId String      @unique
  file   StorageFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  data      Bytes
  createdAt DateTime @default(now())

  @@map("storage_blobs")
}

// ============================================================
// AUDIT LOG — Security trail (who changed what field)
// tenantId is stored as a plain string (no FK) so audit records
// survive tenant deletion without cascade issues.
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  action     String
  resource   String
  resourceId String?
  tenantId   String?  // for multi-tenant audit scoping (H-4)

  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([tenantId])
  @@map("audit_logs")
}

// ============================================================
// ACTIVITY LOG — Human-readable event stream
// ============================================================

model ActivityLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  event       String
  description String
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([tenantId])
  @@index([event])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================================
// MCP / AI EXTENSION LAYER
// Architecture placeholders — no business logic implemented.
// These tables are created now so that activating AI features
// requires zero new migrations.
// ============================================================

enum McpProviderType {
  HIGGSFIELD
  OPENAI
  ANTHROPIC
  CUSTOM
}

enum McpConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  DISABLED
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model McpProvider {
  id          String          @id @default(cuid())
  name        String
  type        McpProviderType
  description String?
  isActive    Boolean         @default(false)

  connections McpConnection[]

  createdAt DateTime @default(now())

  @@map("mcp_providers")
}

model McpConnection {
  id         String              @id @default(cuid())
  providerId String
  provider   McpProvider         @relation(fields: [providerId], references: [id])
  tenantId   String
  status     McpConnectionStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([providerId])
  @@map("mcp_connections")
}

model AiAgent {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      AgentStatus @default(DRAFT)

  permissions AgentPermission[]
  auditLogs   AgentAuditLog[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("ai_agents")
}

model AgentPermission {
  id         String  @id @default(cuid())
  agentId    String
  agent      AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  permission String

  createdAt DateTime @default(now())

  @@index([agentId])
  @@map("agent_permissions")
}

model WorkflowDefinition {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("workflow_definitions")
}

model AgentAuditLog {
  id       String   @id @default(cuid())
  tenantId String
  agentId  String
  agent    AiAgent  @relation(fields: [agentId], references: [id])
  action   String
  result   Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([agentId])
  @@index([createdAt])
  @@map("agent_audit_logs")
}

// ============================================================
// NOTIFICATION — In-app notification queue
// ============================================================

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  type     NotificationType
  title    String
  body     String?
  metadata Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([tenantId])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// WEBSITE CMS — Public marketing site content
//
// Serves the statically exported frontend (apps/web). Content is
// tenant-scoped so the same backend can drive multiple sites and,
// later, Nexuva Core.
//
// Localized text is stored as JSONB in the shape { "tr": "...", "en": "..." }
// matching the `Localized` type in @nexuva/types.
// ============================================================

/// Singleton content blocks keyed by section name: brand, hero, about,
/// cta, contact, footer, servicesMeta, referencesMeta, testimonialsMeta,
/// processMeta. `data` holds the section's full JSON payload.
model WebsiteSection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key  String
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("website_sections")
}

model WebsiteNavItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  label    Json
  href     String
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, position])
  @@map("website_nav_items")
}

/// Client logos shown in the marquee strip.
model WebsiteLogo {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  imageUrl String?
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, position])
  @@map("website_logos")
}

model WebsiteService {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  icon        String
  title       Json
  description Json
  /// Array of Localized feature bullets.
  features    Json
  /// Illustration for the service card and its detail. Chosen from the media
  /// library; an icon alone reads as a template.
  imageUrl    String?
  imageAlt    String?
  /// Optional per-service call to action. Hidden when the label is empty.
  ctaLabel    Json?
  ctaHref     String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, position])
  @@index([tenantId, deletedAt])
  @@map("website_services")
}

model WebsiteStat {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  value    Int
  prefix   String?
  suffix   String  @default("")
  label    Json
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, position])
  @@map("website_stats")
}

model WebsiteReference {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  category Json
  logoUrl  String?
  /// What was done for them. A name and a sector is a logo wall; this is what
  /// makes it a reference.
  description Json?
  /// Their own site, so a reader can check the claim.
  website     String?
  /// A screenshot or photograph of the work.
  imageUrl    String?
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, position])
  @@index([tenantId, deletedAt])
  @@map("website_references")
}

model WebsiteTestimonial {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  quote     Json
  author    String
  role      Json
  company   String
  avatarUrl String?
  rating    Int     @default(5)
  position  Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, position])
  @@index([tenantId, deletedAt])
  @@map("website_testimonials")
}

model WebsiteProcessStep {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       Json
  description Json
  /// lucide-react icon name. The step number stands in without one.
  icon        String?
  imageUrl    String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, position])
  @@map("website_process_steps")
}

/// Where an enquiry stands. The order is the pipeline order.
enum LeadStatus {
  NEW
  REVIEWING
  CONTACTED
  PROPOSAL_SENT
  MEETING
  WAITING
  WON
  LOST
  ARCHIVED
}

/// What happened to a lead. Written by the service, never by a client.
enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  NOTE_ADDED
  FILE_ATTACHED
  READ
  UPDATED
}

/// Submissions from the public contact form. Written by an unauthenticated
/// endpoint, so the service enforces validation and length caps.
///
/// The table keeps its name because it holds the enquiries already received;
/// everything the CRM needs is added alongside rather than migrated into a new
/// one.
model ContactMessage {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  email   String
  phone   String?
  subject String?
  message String

  /// Collected by the extended contact form; absent on older enquiries.
  company String?
  service String?
  budget  String?

  /// Human-facing reference, so an enquiry can be quoted on the phone.
  requestNo Int @default(autoincrement())

  status LeadStatus @default(NEW)

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id])

  /// Free-form labels. A table would buy nothing a string array does not.
  tags String[] @default([])

  /// When the visitor agreed to the privacy notice. Null for enquiries that
  /// predate the consent checkbox.
  consentAt DateTime?

  /// Last time anyone did anything to this lead, for sorting the neglected
  /// ones to the top.
  lastActionAt DateTime @default(now())

  notes      LeadNote[]
  activities LeadActivity[]
  files      StorageFile[]

  isRead Boolean   @default(false)
  readAt DateTime?

  /// Request metadata retained for abuse investigation.
  ipAddress String?
  userAgent String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, isRead])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@map("contact_messages")
}

/// A comment someone left on a lead.
model LeadNote {
  id     String         @id @default(cuid())
  leadId String
  lead   ContactMessage @relation(fields: [leadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt(sort: Desc)])
  @@map("lead_notes")
}

/// The timeline. Append-only: every change to a lead lands here, so "what
/// happened to this enquiry" has an answer that does not depend on anyone
/// having written a note about it.
model LeadActivity {
  id     String         @id @default(cuid())
  leadId String
  lead   ContactMessage @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Null when the system acted rather than a person — an arriving enquiry.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  type        LeadActivityType
  description String
  /// Before/after for a status change, the assignee for an assignment.
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt(sort: Desc)])
  @@map("lead_activities")
}

/// Outcome of a publish attempt.
///
/// A deploy hook returns as soon as the build is queued, so success at the
/// moment of triggering says nothing about whether the site actually updated.
/// PENDING records that gap; the build's real result arrives later.
enum PublishState {
  PENDING
  SUCCEEDED
  FAILED
}

/// One row per publish attempt: who asked, when, how, and what came of it.
///
/// This used to live in a field on the service, which meant every API restart
/// erased the history — nobody could tell what had been published or by whom,
/// and a redeploy silently reset the panel to "no publish recorded".
model PublishLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Null for an automatic publish, which no person triggered.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  strategy String
  state    PublishState @default(PENDING)
  detail   String

  /// Identifier returned by the deploy provider, when it gives one. Without it
  /// the build's outcome cannot be looked up afterwards.
  deployId String?

  /// Which content version this publish carried. Null when the attempt failed
  /// before a version could be frozen.
  version Int?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([tenantId, startedAt(sort: Desc)])
  @@index([tenantId, state])
  @@map("publish_logs")
}

/// A complete copy of the site's content as it was published.
///
/// The website tables are the draft: editors change them freely and the public
/// site does not follow. Publishing takes a snapshot, and the site serves the
/// snapshot. That is what makes draft and published two different things —
/// a status column on each row could not express "published version live, newer
/// draft in progress", because a row can only be in one state at a time.
///
/// Rolling back is then exact rather than reconstructed: the snapshot is
/// literally what visitors were served.
model ContentVersion {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Sequential per tenant, so a version can be referred to by number.
  number Int

  /// The whole SiteContent document, in the shape the site consumes.
  snapshot Json

  /// The one version the public site is currently served from.
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  /// Null for a version created automatically.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  /// What this publish was for, in the operator's words.
  note String?

  /// Set when this version was produced by restoring an earlier one.
  restoredFrom Int?

  createdAt DateTime @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, isPublished])
  @@map("content_versions")
}

/// Per-tenant website facts that are read far more often than they change.
///
/// `lastContentChangeAt` is a materialised value: the alternative is an
/// aggregate across all nine content tables on every status poll, and the panel
/// polls this on each page view.
model WebsiteState {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lastContentChangeAt DateTime?

  updatedAt DateTime @updatedAt

  @@map("website_state")
}

// ============================================================
// MAIL — configuration, templates and delivery log
// ============================================================

/// How this tenant sends email.
///
/// In the database rather than the environment because the person who needs to
/// change it is the one using the panel, and an environment variable means a
/// redeploy and somebody with access to the hosting dashboard. Environment
/// values still work as a fallback, so an existing deployment keeps sending.
///
/// The secret is write-only over the API: it goes in, and what comes back says
/// only whether one is set.
model MailSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// 'resend' | 'smtp' | 'sendgrid'
  provider String @default("resend")

  fromEmail String
  fromName  String @default("Nexuva")
  replyTo   String?

  /// Where new enquiry notifications go. Comma-separated.
  notifyTo String @default("")

  /// Provider API key (resend, sendgrid).
  apiKey String?

  /// SMTP, including Gmail and Microsoft, which are ordinary SMTP servers.
  smtpHost     String?
  smtpPort     Int?     @default(587)
  smtpUser     String?
  smtpPassword String?
  smtpSecure   Boolean  @default(false)

  /// Outcome of the last test send, so the panel can show it after a reload.
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mail_settings")
}

/// A message the platform sends on its own.
///
/// Editable because the words belong to the business, not to the code: the
/// acknowledgement a customer receives is the company's first written reply,
/// and changing it should not need a deploy.
model MailTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Stable identifier the code sends by, e.g. "lead_received".
  key         String
  name        String
  description String  @default("")
  subject     String
  /// Body with {{variable}} placeholders. Wrapped in the branded shell on send.
  body        String
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("mail_templates")
}

enum MailStatus {
  SENT
  FAILED
}

/// Every send attempt.
///
/// Without this, "did the customer get the acknowledgement" is unanswerable —
/// and it is asked every time somebody complains they heard nothing back.
model MailLog {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  to          String
  subject     String
  templateKey String?
  provider    String
  status      MailStatus
  /// Provider message on failure. Kept verbatim: paraphrasing loses the cause.
  error       String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status])
  @@map("mail_logs")
}

// ============================================================
// ANALYTICS — first-party, cookie-free, no IP retained
// ============================================================

/// One page view.
///
/// Built rather than bought because the alternative is shipping a third party's
/// script to every visitor, which is a consent banner, a data transfer to
/// somebody else's servers, and a dependency on their availability.
///
/// No IP address is stored. Distinguishing one visitor from another needs only
/// a value that is stable within a day and meaningless after it, so the address
/// is hashed with a salt that changes daily and discarded. That makes a visitor
/// count possible and makes re-identifying anyone impossible — which is what
/// KVKK asks for, and also simply the right way round.
model PageView {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  path     String
  referrer String?
  /// Where the visit came from, reduced to a name: Google, Instagram, Direct.
  source   String  @default("direct")

  device  String @default("desktop")
  browser String @default("")
  country String @default("")

  /// Daily-salted hash of the address. Identifies a session for one day and
  /// nothing at all afterwards.
  visitorHash String

  /// Seconds spent on the page, sent when the visitor leaves. Null if they
  /// closed the tab in a way the browser did not report.
  durationSeconds Int?
  /// Furthest scroll depth reached, as a percentage.
  scrollDepth     Int?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, path])
  @@index([tenantId, visitorHash])
  @@map("page_views")
}

/// A thing a visitor did that matters: a CTA press, a form submission.
model AnalyticsEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// 'cta_click' | 'form_submit' | 'form_start'
  name  String
  path  String
  /// Which button, which form — whatever names the thing that was used.
  label String @default("")

  visitorHash String
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, name])
  @@map("analytics_events")
}
