generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                     String                   @id @default(cuid()) @db.Uuid
  company_name           String
  tax_number             String                   @unique
  tax_office             String?
  country                String
  city                   String
  address                String?
  phone                  String
  email                  String
  website                String?
  logo                   String?
  status                 CompanyStatus            @default(PASSIVE)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  created_by             String?                  @db.Uuid
  updated_at             DateTime                 @db.Timestamptz(6)
  updated_by             String?                  @db.Uuid
  deleted_at             DateTime?                @db.Timestamptz(6)
  deleted_by             String?                  @db.Uuid
  accounts               accounts?
  customer_contacts      customer_contacts[]
  customer_health_scores customer_health_scores[]
  customer_products      customer_products[]
  customers              customers?
  feature_requests       feature_requests[]
  invoices               invoices[]
  licenses               licenses[]
  payments               payments[]
  revenues               revenues[]
  subscriptions          subscriptions[]
  tickets                tickets[]
  users                  User[]

  @@map("companies")
}

model Product {
  id                                                                        String                 @id @default(cuid()) @db.Uuid
  product_code                                                              String                 @unique
  name                                                                      String
  description                                                               String?
  category                                                                  ProductCategory
  current_version                                                           String?
  release_date                                                              DateTime?              @db.Timestamptz(6)
  status                                                                    ProductStatus          @default(PLANNING)
  owner_team                                                                String?
  repository                                                                String?
  documentation_url                                                         String?
  support_email                                                             String?
  created_at                                                                DateTime               @default(now()) @db.Timestamptz(6)
  created_by                                                                String?                @db.Uuid
  updated_at                                                                DateTime               @db.Timestamptz(6)
  updated_by                                                                String?                @db.Uuid
  deleted_at                                                                DateTime?              @db.Timestamptz(6)
  deleted_by                                                                String?                @db.Uuid
  customer_products                                                         customer_products[]
  feature_requests                                                          feature_requests[]
  licenses                                                                  licenses[]
  product_apis                                                              product_apis[]
  product_dependencies_product_dependencies_depends_on_product_idToproducts product_dependencies[] @relation("product_dependencies_depends_on_product_idToproducts")
  product_dependencies_product_dependencies_product_idToproducts            product_dependencies[] @relation("product_dependencies_product_idToproducts")
  product_domains                                                           product_domains[]
  product_health                                                            product_health[]
  product_versions                                                          product_versions[]
  tickets                                                                   tickets[]

  @@map("products")
}

model Domain {
  id              String            @id @default(cuid()) @db.Uuid
  domain          String            @unique
  provider        String?
  ssl_status      String?
  dns_provider    String?
  cloudflare_zone String?
  renewal_date    DateTime?         @db.Timestamptz(6)
  status          String?
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  created_by      String?           @db.Uuid
  updated_at      DateTime          @db.Timestamptz(6)
  updated_by      String?           @db.Uuid
  deleted_at      DateTime?         @db.Timestamptz(6)
  deleted_by      String?           @db.Uuid
  product_domains product_domains[]

  @@map("domains")
}

model Page {
  id              String            @id @default(cuid()) @db.Uuid
  title           String
  slug            String            @unique
  content         Json?
  status          ContentStatus     @default(DRAFT)
  published_at    DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  created_by      String?           @db.Uuid
  updated_at      DateTime          @db.Timestamptz(6)
  updated_by      String?           @db.Uuid
  deleted_at      DateTime?         @db.Timestamptz(6)
  deleted_by      String?           @db.Uuid
  hero_sections   hero_sections[]
  page_components page_components[]

  @@map("pages")
}

model SeoSetting {
  id          String    @id @default(cuid()) @db.Uuid
  entity_type String
  entity_id   String    @db.Uuid
  title       String?
  description String?
  keywords    String?
  canonical   String?
  robots      String?
  og          Json?
  twitter     Json?
  schema      Json?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  created_by  String?   @db.Uuid
  updated_at  DateTime  @db.Timestamptz(6)
  updated_by  String?   @db.Uuid
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?   @db.Uuid

  @@index([entity_type, entity_id])
  @@map("seo_settings")
}

model User {
  id                       String                     @id @default(cuid()) @db.Uuid
  identity_type            IdentityType
  company_id               String?                    @db.Uuid
  full_name                String
  email                    String                     @unique
  password_hash            String?
  status                   UserStatus                 @default(INVITED)
  last_login               DateTime?                  @db.Timestamptz(6)
  mfa_enabled              Boolean                    @default(false)
  mfa_secret               String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  created_by               String?                    @db.Uuid
  updated_at               DateTime                   @db.Timestamptz(6)
  updated_by               String?                    @db.Uuid
  deleted_at               DateTime?                  @db.Timestamptz(6)
  deleted_by               String?                    @db.Uuid
  api_tokens               api_tokens[]
  in_app_notifications     in_app_notifications[]
  notification_preferences notification_preferences[]
  password_history         password_history[]
  sessions                 sessions[]
  user_roles               user_roles[]
  user_teams               user_teams[]
  companies                Company?                   @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@index([identity_type])
  @@map("users")
}

model Permission {
  id               String             @id @default(cuid()) @db.Uuid
  code             String             @unique
  description      String?
  resource         String
  action           String
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  created_by       String?            @db.Uuid
  updated_at       DateTime           @db.Timestamptz(6)
  updated_by       String?            @db.Uuid
  deleted_at       DateTime?          @db.Timestamptz(6)
  deleted_by       String?            @db.Uuid
  role_permissions role_permissions[]

  @@map("permissions")
}

model AuditLog {
  id          String   @id @default(cuid()) @db.Uuid
  user_id     String?  @db.Uuid
  entity_type String
  entity_id   String   @db.Uuid
  field       String
  old_value   String?
  new_value   String?
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

model ActivityLog {
  id          String   @id @default(cuid()) @db.Uuid
  user_id     String?  @db.Uuid
  domain      String?
  action      String
  description String?
  entity_type String?
  entity_id   String?  @db.Uuid
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([user_id])
  @@map("activity_logs")
}

model Notification {
  id                String               @id @default(cuid()) @db.Uuid
  recipient         String
  channel           NotificationChannel
  template_code     String?
  subject           String?
  body              String?
  priority          NotificationPriority @default(MEDIUM)
  status            DeliveryStatus       @default(QUEUED)
  retry_count       Int                  @default(0)
  scheduled_at      DateTime?            @db.Timestamptz(6)
  delivered_at      DateTime?            @db.Timestamptz(6)
  created_at        DateTime             @default(now()) @db.Timestamptz(6)
  created_by        String?              @db.Uuid
  updated_at        DateTime             @db.Timestamptz(6)
  updated_by        String?              @db.Uuid
  deleted_at        DateTime?            @db.Timestamptz(6)
  deleted_by        String?              @db.Uuid
  notification_logs notification_logs[]

  @@index([status, scheduled_at])
  @@map("notifications")
}

model accounts {
  id                  String    @id @db.Uuid
  company_id          String    @unique @db.Uuid
  debit               Decimal   @default(0) @db.Decimal(14, 2)
  credit              Decimal   @default(0) @db.Decimal(14, 2)
  balance             Decimal   @default(0) @db.Decimal(14, 2)
  last_payment_at     DateTime? @db.Timestamptz(6)
  last_transaction_at DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  created_by          String?   @db.Uuid
  updated_at          DateTime  @db.Timestamptz(6)
  updated_by          String?   @db.Uuid
  deleted_at          DateTime? @db.Timestamptz(6)
  deleted_by          String?   @db.Uuid
  companies           Company   @relation(fields: [company_id], references: [id])
}

model api_tokens {
  id           String         @id @db.Uuid
  name         String
  token_hash   String
  scopes       String[]
  expires_at   DateTime?      @db.Timestamptz(6)
  last_used_at DateTime?      @db.Timestamptz(6)
  status       ApiTokenStatus @default(ACTIVE)
  user_id      String?        @db.Uuid
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  created_by   String?        @db.Uuid
  users        User?          @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model automation_rules {
  id            String    @id @db.Uuid
  name          String
  trigger_event String
  conditions    Json?
  actions       Json?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  created_by    String?   @db.Uuid
  updated_at    DateTime  @db.Timestamptz(6)
  updated_by    String?   @db.Uuid
  deleted_at    DateTime? @db.Timestamptz(6)
  deleted_by    String?   @db.Uuid

  @@index([trigger_event])
}

model blogs {
  id              String        @id @db.Uuid
  title           String
  slug            String        @unique
  excerpt         String?
  cover_image     String?
  content         String?
  category        String?
  tags            String[]
  author_id       String?       @db.Uuid
  seo_title       String?
  seo_description String?
  og_image        String?
  canonical_url   String?
  status          ContentStatus @default(DRAFT)
  published_at    DateTime?     @db.Timestamptz(6)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  created_by      String?       @db.Uuid
  updated_at      DateTime      @db.Timestamptz(6)
  updated_by      String?       @db.Uuid
  deleted_at      DateTime?     @db.Timestamptz(6)
  deleted_by      String?       @db.Uuid

  @@index([status])
}

model customer_contacts {
  id         String    @id @db.Uuid
  company_id String    @db.Uuid
  full_name  String
  title      String?
  email      String?
  phone      String?
  is_primary Boolean   @default(false)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  created_by String?   @db.Uuid
  updated_at DateTime  @db.Timestamptz(6)
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.Uuid
  companies  Company   @relation(fields: [company_id], references: [id])

  @@index([company_id])
}

model customer_health_scores {
  id            String   @id @db.Uuid
  company_id    String   @db.Uuid
  score         Int
  risk_level    String?
  calculated_at DateTime @default(now()) @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  companies     Company  @relation(fields: [company_id], references: [id])

  @@index([company_id])
}

model customer_notes {
  id          String    @id @db.Uuid
  customer_id String    @db.Uuid
  note_type   String
  note        String
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  created_by  String?   @db.Uuid
  updated_at  DateTime  @db.Timestamptz(6)
  updated_by  String?   @db.Uuid
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?   @db.Uuid
  customers   customers @relation(fields: [customer_id], references: [id])

  @@index([customer_id])
}

model customer_products {
  id          String    @id @db.Uuid
  company_id  String    @db.Uuid
  product_id  String    @db.Uuid
  assigned_at DateTime  @default(now()) @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  created_by  String?   @db.Uuid
  updated_at  DateTime  @db.Timestamptz(6)
  updated_by  String?   @db.Uuid
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?   @db.Uuid
  companies   Company   @relation(fields: [company_id], references: [id])
  products    Product   @relation(fields: [product_id], references: [id])

  @@unique([company_id, product_id])
  @@index([product_id])
}

model customer_tags {
  customer_id String    @db.Uuid
  tag_id      String    @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  tags        tags      @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([customer_id, tag_id])
  @@index([tag_id])
}

model customers {
  id               String           @id @db.Uuid
  company_id       String           @unique @db.Uuid
  assigned_user_id String?          @db.Uuid
  customer_status  CustomerStatus   @default(LEAD)
  lead_source      String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  created_by       String?          @db.Uuid
  updated_at       DateTime         @db.Timestamptz(6)
  updated_by       String?          @db.Uuid
  deleted_at       DateTime?        @db.Timestamptz(6)
  deleted_by       String?          @db.Uuid
  customer_notes   customer_notes[]
  customer_tags    customer_tags[]
  companies        Company          @relation(fields: [company_id], references: [id])

  @@index([assigned_user_id])
  @@index([customer_status])
}

model dashboard_widgets {
  id           String     @id @db.Uuid
  dashboard_id String     @db.Uuid
  widget_id    String     @db.Uuid
  order        Int        @default(0)
  position_x   Int        @default(0)
  position_y   Int        @default(0)
  width        Int?
  height       Int?
  settings     Json?
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  created_by   String?    @db.Uuid
  updated_at   DateTime   @db.Timestamptz(6)
  updated_by   String?    @db.Uuid
  deleted_at   DateTime?  @db.Timestamptz(6)
  deleted_by   String?    @db.Uuid
  dashboards   dashboards @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  widgets      widgets    @relation(fields: [widget_id], references: [id])

  @@index([dashboard_id])
  @@index([widget_id])
}

model dashboards {
  id                String              @id @db.Uuid
  name              String
  type              String?
  owner_user_id     String?             @db.Uuid
  is_default        Boolean             @default(false)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  created_by        String?             @db.Uuid
  updated_at        DateTime            @db.Timestamptz(6)
  updated_by        String?             @db.Uuid
  deleted_at        DateTime?           @db.Timestamptz(6)
  deleted_by        String?             @db.Uuid
  dashboard_widgets dashboard_widgets[]

  @@index([owner_user_id])
}

model departments {
  id                String        @id @db.Uuid
  name              String
  parent_id         String?       @db.Uuid
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  created_by        String?       @db.Uuid
  updated_at        DateTime      @db.Timestamptz(6)
  updated_by        String?       @db.Uuid
  deleted_at        DateTime?     @db.Timestamptz(6)
  deleted_by        String?       @db.Uuid
  departments       departments?  @relation("departmentsTodepartments", fields: [parent_id], references: [id])
  other_departments departments[] @relation("departmentsTodepartments")
  teams             teams[]

  @@index([parent_id])
}

model domain_events {
  id             String       @id @db.Uuid
  event_name     String
  aggregate_type String
  aggregate_id   String       @db.Uuid
  payload        Json
  status         OutboxStatus @default(PENDING)
  published_at   DateTime?    @db.Timestamptz(6)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)

  @@index([aggregate_type, aggregate_id])
  @@index([status])
}

model email_templates {
  id              String         @id @db.Uuid
  name            String
  code            String         @unique
  subject         String
  html_body       String
  plain_text_body String?
  variables       Json?
  language        String         @default("tr")
  status          TemplateStatus @default(ACTIVE)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  created_by      String?        @db.Uuid
  updated_at      DateTime       @db.Timestamptz(6)
  updated_by      String?        @db.Uuid
  deleted_at      DateTime?      @db.Timestamptz(6)
  deleted_by      String?        @db.Uuid
}

model expenses {
  id           String    @id @db.Uuid
  expense_type String
  vendor       String?
  amount       Decimal   @db.Decimal(14, 2)
  currency     String    @db.VarChar(3)
  expense_date DateTime  @db.Timestamptz(6)
  is_recurring Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  created_by   String?   @db.Uuid
  updated_at   DateTime  @db.Timestamptz(6)
  updated_by   String?   @db.Uuid
  deleted_at   DateTime? @db.Timestamptz(6)
  deleted_by   String?   @db.Uuid
}

model faqs {
  id         String    @id @db.Uuid
  question   String
  answer     String
  category   String?
  sort_order Int       @default(0)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  created_by String?   @db.Uuid
  updated_at DateTime  @db.Timestamptz(6)
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.Uuid
}

model feature_requests {
  id          String               @id @db.Uuid
  company_id  String?              @db.Uuid
  product_id  String?              @db.Uuid
  title       String
  description String?
  status      FeatureRequestStatus @default(EVALUATING)
  votes       Int                  @default(0)
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  created_by  String?              @db.Uuid
  updated_at  DateTime             @db.Timestamptz(6)
  updated_by  String?              @db.Uuid
  deleted_at  DateTime?            @db.Timestamptz(6)
  deleted_by  String?              @db.Uuid
  companies   Company?             @relation(fields: [company_id], references: [id])
  products    Product?             @relation(fields: [product_id], references: [id])

  @@index([company_id])
  @@index([product_id])
}

model form_submissions {
  id           String   @id @db.Uuid
  form_id      String   @db.Uuid
  data         Json
  ip_address   String?
  lead_created Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  forms        forms    @relation(fields: [form_id], references: [id])

  @@index([form_id])
}

model forms {
  id               String             @id @db.Uuid
  code             String             @unique
  name             String
  fields           Json?
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  created_by       String?            @db.Uuid
  updated_at       DateTime           @db.Timestamptz(6)
  updated_by       String?            @db.Uuid
  deleted_at       DateTime?          @db.Timestamptz(6)
  deleted_by       String?            @db.Uuid
  form_submissions form_submissions[]
}

model hero_sections {
  id               String        @id @db.Uuid
  page_id          String?       @db.Uuid
  title            String
  subtitle         String?
  description      String?
  primary_button   String?
  secondary_button String?
  background_image String?
  video            String?
  status           ContentStatus @default(DRAFT)
  published_at     DateTime?     @db.Timestamptz(6)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  created_by       String?       @db.Uuid
  updated_at       DateTime      @db.Timestamptz(6)
  updated_by       String?       @db.Uuid
  deleted_at       DateTime?     @db.Timestamptz(6)
  deleted_by       String?       @db.Uuid
  pages            Page?         @relation(fields: [page_id], references: [id])

  @@index([page_id])
}

model in_app_notifications {
  id          String               @id @db.Uuid
  user_id     String               @db.Uuid
  title       String
  description String?
  type        String?
  priority    NotificationPriority @default(MEDIUM)
  is_read     Boolean              @default(false)
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  users       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
}

model incident_tickets {
  incident_id String    @db.Uuid
  ticket_id   String    @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  incidents   incidents @relation(fields: [incident_id], references: [id], onDelete: Cascade)
  tickets     tickets   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@id([incident_id, ticket_id])
  @@index([ticket_id])
}

model incidents {
  id               String             @id @db.Uuid
  title            String
  description      String?
  severity         IncidentSeverity   @default(MEDIUM)
  status           IncidentStatus     @default(OPEN)
  started_at       DateTime?          @db.Timestamptz(6)
  resolved_at      DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  created_by       String?            @db.Uuid
  updated_at       DateTime           @db.Timestamptz(6)
  updated_by       String?            @db.Uuid
  deleted_at       DateTime?          @db.Timestamptz(6)
  deleted_by       String?            @db.Uuid
  incident_tickets incident_tickets[]
}

model invoices {
  id                 String         @id @db.Uuid
  company_id         String         @db.Uuid
  subscription_id    String?        @db.Uuid
  invoice_number     String
  amount             Decimal        @db.Decimal(14, 2)
  currency           String         @db.VarChar(3)
  tax_amount         Decimal?       @db.Decimal(14, 2)
  status             InvoiceStatus  @default(DRAFT)
  due_date           DateTime?      @db.Timestamptz(6)
  paid_date          DateTime?      @db.Timestamptz(6)
  external_reference String?
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  created_by         String?        @db.Uuid
  updated_at         DateTime       @db.Timestamptz(6)
  updated_by         String?        @db.Uuid
  deleted_at         DateTime?      @db.Timestamptz(6)
  deleted_by         String?        @db.Uuid
  companies          Company        @relation(fields: [company_id], references: [id])
  subscriptions      subscriptions? @relation(fields: [subscription_id], references: [id])
  payments           payments[]

  @@index([company_id])
