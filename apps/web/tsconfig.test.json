{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": "../..",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false,
    "isolatedModules": false,
    "allowImportingTsExtensions": false,
    "plugins": []
  },
  "include": ["test/**/*.test.ts"],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
